+"""Pipeline orchestration for Creator Income Copilot.
+
+Wave 2 (agent F). ``build_analyze_response`` is the single entry point the
+FastAPI layer (``main.py``) calls: it runs the analytics computation, feeds
+the report to the LLM insight generator (reading ``OPENROUTER_API_KEY`` from
+the environment itself) and assembles the final ``AnalyzeResponse`` with
+parser warnings passed through untouched.
+
+Environment: ``load_dotenv()`` runs at import time so ``os.getenv`` below
+sees keys from ``.env`` before the first call.
+"""
+from __future__ import annotations
+
+import os
+
+from dotenv import load_dotenv
+
+from core.analytics import build_report
+from core.llm import generate_insights
+from core.models import AnalyzeResponse, SaleRecord
+
+load_dotenv()
+
+
+def build_analyze_response(
+    records: list[SaleRecord], warnings: list[str]
+) -> AnalyzeResponse:
+    """Build a full AnalyzeResponse for a list of normalized sale records.
+
+    Orchestration only:
+    1. ``analytics.build_report(records)`` — deterministic report computation.
+    2. ``llm.generate_insights(report, os.getenv("OPENROUTER_API_KEY"))`` —
+       LLM-backed insights that degrade to the heuristic fallback on any
+       failure (missing key, timeout, bad JSON), so this never raises.
+    3. Assemble the ``AnalyzeResponse`` with ``warnings`` passed through
+       unchanged (they come from CSV parsing in ``core.parser``).
+
+    Args:
+        records: Normalized ``SaleRecord`` list (parser output).
+        warnings: Non-fatal parsing warnings to surface to the user.
+
+    Returns:
+        The assembled ``AnalyzeResponse`` (analytics + insights + warnings).
+    """
+    report = build_report(records)
+    insights = generate_insights(report, os.getenv("OPENROUTER_API_KEY"))
+    return AnalyzeResponse(
+        analytics=report,
+        insights=insights,
+        warnings=warnings,
+    )

