sys.path.insert(0, '.')
from tests.test_perf import _gen_payhip_csv
from core.parser import parse_csv
from core.analytics import build_report
from core.report import build_analyze_response
os.environ['OPENROUTER_API_KEY'] = ''

def bench(n):
    csv_text = _gen_payhip_csv(n=n)
    t0 = time.perf_counter(); records, warnings = parse_csv(csv_text, source_hint='payhip'); t1 = time.perf_counter()
    build_report(records); t2 = time.perf_counter()
    build_analyze_response(records, warnings); t3 = time.perf_counter()
    return t1-t0, t2-t1, t3-t2, len(records)

for n in (10_000, 20_000, 40_000):
    p, r, a, cnt = bench(n)
    print(f"n={cnt:6d}  parse={p:.3f}s  report={r:.3f}s  analyze={a:.3f}s")
