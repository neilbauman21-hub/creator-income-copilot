+def allocate(total, weights):
+    """Exact integer allocation of `total` across products (largest remainder)."""
+    raw = [total * w for w in weights]
+    base = [int(x) for x in raw]
+    rem = total - sum(base)
+    for i in sorted(range(len(weights)), key=lambda i: raw[i] - base[i],
+                    reverse=True)[:rem]:
+        base[i] += 1
+    return base
+
