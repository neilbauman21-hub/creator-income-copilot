+"""Throwaway verification script — runs the real pipeline on both samples
+and prints the exact values the docs claim. Not part of the repo's code."""
+import sys
+sys.path.insert(0, "/Users/neilthepineapplegoat/creator-income-copilot")
+
+from pathlib import Path
+from core.parser import parse_csv
+from core.analytics import build_report
+from core.report import _compute_extra
+from core.insights_extra import deep_dive_insights
+from core.llm import heuristic_insights
+
+BASE = Path("/Users/neilthepineapplegoat/creator-income-copilot")
+
+for name, hint in (("payhip_sample.csv", None), ("store2_gumroad.csv", "gumroad")):
+    text = (BASE / "sample_data" / name).read_text(encoding="utf-8")
+    records, warnings = parse_csv(text, source_hint=hint)
+    report = build_report(records)
+    extra = _compute_extra(records)
+    dd = deep_dive_insights(report, extra)
+    ins = heuristic_insights(report)
+    print(f"===== {name} (hint={hint}) =====")
+    print(f"parsed records: {len(records)}  refunded: {sum(1 for r in records if r.refunded)}  warnings: {len(warnings)}")
+    print(f"period: {report.period_start} -> {report.period_end}")
+    print(f"total_revenue: {report.total_revenue}  orders: {report.total_orders}  customers: {report.unique_customers}")
+    print(f"aov: {report.avg_order_value}  repeat_rate: {report.repeat_purchase_rate}")
+    print("top products:")
+    for p in report.top_products:
+        print(f"   {p.name!r}: rev={p.revenue} units={p.units} share={p.share_pct} refunds={p.refunds} momentum={p.momentum} {p.momentum_pct}")
+    print("trends:")
+    for t in report.trends:
+        print(f"   {t.label!r}: {t.direction} {t.magnitude_pct} | {t.description}")
+    print("churn:")
+    for c in report.churn_signals:
+        print(f"   {c.product!r}: {c.signal_type} sev={c.severity} | {c.description}")
+    print("deep-dive insights:")
+    for s in dd:
+        print(f"   - {s}")
+    print(f"insights count: {len(ins.insights)} used_fallback={ins.used_fallback}")
+    for s in ins.insights:
+        print(f"   * {s}")
+    print(f"promo subject: {ins.promo_email.subject!r}")
+    print(f"next product: {ins.next_product.name!r}")
+    print(f"   rationale: {ins.next_product.rationale[:200]}")
+    print(f"   evidence: {ins.next_product.evidence[:200]}")
+    print()
